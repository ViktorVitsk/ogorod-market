# Local development only. This value is public because it is stored in git.
# Generate a unique secret before exposing the API beyond your own machine.
# The API refuses to start when JWT_SECRET_KEY is missing or shorter than 32 characters.
JWT_SECRET_KEY=local-dev-only-do-not-use-outside-this-machine

# Database. Inside Docker Compose the API service overrides this with the postgres hostname.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ogorod-market

# API
API_HOST=0.0.0.0
API_PORT=8000

# Browser-reachable API origin. The web client appends /api itself.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to true to log SQL statements.
SQL_ECHO=false